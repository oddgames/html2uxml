/* Form controls default to intrinsic-width sizing (HTML inline-block-ish),
   not flex-stretch. Override `align-self` in your USS if you want a control
   to fill its container. */
.html2uxml-toggle {
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: flex-start;
}

.html2uxml-radio {
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: flex-start;
    margin-right: 8px;
}

.html2uxml-toggle-box {
    position: relative;
    width: 13px;
    height: 13px;
    min-width: 13px;
    min-height: 13px;
    flex-grow: 0;
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgb(115, 115, 115);
    border-radius: 2px;
    background-color: rgba(0, 0, 0, 0);
}

.html2uxml-toggle.__h2u-state-checked > .html2uxml-toggle-box {
    background-color: rgb(13, 122, 219);
    border-color: rgb(13, 122, 219);
}

.html2uxml-toggle-tick {
    position: absolute;
    left: 3px;
    top: 0;
    width: 5px;
    height: 9px;
    background-color: rgba(0, 0, 0, 0);
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-right-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    rotate: 45deg;
    display: none;
}

.html2uxml-toggle.__h2u-state-checked .html2uxml-toggle-tick {
    display: flex;
}

.html2uxml-radio-circle {
    position: relative;
    width: 13px;
    height: 13px;
    min-width: 13px;
    min-height: 13px;
    flex-grow: 0;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(115, 115, 115);
    border-radius: 7px;
}

.html2uxml-radio-dot {
    position: absolute;
    left: 3px;
    top: 3px;
    width: 7px;
    height: 7px;
    background-color: rgb(13, 122, 219);
    border-radius: 4px;
    display: none;
}

.html2uxml-radio.__h2u-state-checked .html2uxml-radio-dot {
    display: flex;
}

.html2uxml-choice-label {
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 0;
    margin-bottom: 0;
    -unity-text-align: middle-left;
}

/* Focus / hover / disabled — real CSS with comma-grouped selectors */
.html2uxml-toggle:focus > .html2uxml-toggle-box,
.html2uxml-radio:focus > .html2uxml-radio-circle {
    border-color: rgb(13, 122, 219);
}

.html2uxml-toggle:hover > .html2uxml-toggle-box,
.html2uxml-radio:hover > .html2uxml-radio-circle {
    border-color: rgb(80, 80, 80);
}

.html2uxml-toggle:disabled,
.html2uxml-radio:disabled {
    opacity: 0.5;
}

/* Slider hover/focus/disabled */
.html2uxml-slider:focus .html2uxml-slider-thumb {
    border-width: 2px;
    border-color: rgb(13, 122, 219);
}

.html2uxml-slider:hover .html2uxml-slider-thumb {
    background-color: rgb(35, 142, 235);
}

.html2uxml-slider:disabled {
    opacity: 0.5;
}

/* Dropdown hover/focus/disabled */
.html2uxml-dropdown:focus {
    border-color: rgb(13, 122, 219);
}

.html2uxml-dropdown:hover {
    background-color: rgb(245, 245, 245);
}

.html2uxml-dropdown:disabled {
    opacity: 0.5;
}

.html2uxml-dropdown-option:hover {
    background-color: rgb(229, 241, 251);
}

/* Button focus/disabled (hover already defined later) */
.html2uxml-button:focus {
    border-color: rgb(13, 122, 219);
}

.html2uxml-button:disabled {
    opacity: 0.5;
}

/* TextField/FloatField hover/disabled */
.html2uxml-textfield:hover,
.html2uxml-floatfield:hover {
    border-color: rgb(80, 80, 80);
}

.html2uxml-textfield:disabled,
.html2uxml-floatfield:disabled {
    opacity: 0.5;
}

/* Indeterminate state for tri-state checkbox */
.html2uxml-toggle.__h2u-state-indeterminate > .html2uxml-toggle-box {
    background-color: rgb(13, 122, 219);
    border-color: rgb(13, 122, 219);
}

.html2uxml-toggle.__h2u-state-indeterminate > .html2uxml-toggle-box > .html2uxml-toggle-tick {
    display: none;
}

.html2uxml-toggle-dash {
    position: absolute;
    left: 2px;
    top: 5px;
    width: 9px;
    height: 2px;
    background-color: rgb(255, 255, 255);
    display: none;
}

.html2uxml-toggle.__h2u-state-indeterminate > .html2uxml-toggle-box > .html2uxml-toggle-dash {
    display: flex;
}

/* Dropdown option highlight (keyboard nav) */
.html2uxml-dropdown-option.__h2u-state-highlighted {
    background-color: rgb(13, 122, 219);
    color: rgb(255, 255, 255);
}

/* Button press feedback */
.__h2u-state-pressed {
    scale: 0.98 0.98;
}

/* Browser-default form-control chrome — applied via package USS so source
   CSS targeting the same element overrides via cascade. */
.html2uxml-button {
    background-color: rgb(239, 239, 239);
    border-width: 1px;
    border-color: rgb(118, 118, 118);
    border-radius: 2px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 2px;
    padding-bottom: 2px;
    color: rgb(0, 0, 0);
}

.html2uxml-button:hover {
    background-color: rgb(229, 241, 251);
    border-color: rgb(0, 120, 215);
}

.html2uxml-textfield {
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(118, 118, 118);
    border-radius: 2px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
    color: rgb(0, 0, 0);
}

.html2uxml-floatfield {
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(118, 118, 118);
    border-radius: 2px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
    color: rgb(0, 0, 0);
}

.html2uxml-textfield:focus {
    border-color: rgb(0, 120, 215);
}

.html2uxml-floatfield:focus {
    border-color: rgb(0, 120, 215);
}

/* Slider — track + fill + thumb defaults. Override in source CSS via the
   same class names to restyle without subclassing. */
.html2uxml-slider {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    min-height: 20px;
}

.html2uxml-slider-track {
    position: relative;
    flex-grow: 1;
    height: 3px;
    background-color: rgb(229, 229, 229);
    border-width: 0.5px;
    border-color: rgb(178, 178, 178);
    border-radius: 2px;
}

.html2uxml-slider-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 3px;
    background-color: rgb(13, 122, 219);
    border-radius: 2px;
}

.html2uxml-slider-thumb {
    position: absolute;
    top: -6px;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    background-color: rgb(13, 122, 219);
    border-width: 0;
    border-radius: 7px;
}

/* Dropdown — wrapper, label, arrow, menu, option. Override via the same
   class names in source CSS to restyle. */
.html2uxml-dropdown {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    position: relative;
}

.html2uxml-dropdown-label {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.html2uxml-dropdown-arrow {
    width: 7px;
    height: 7px;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: center;
    margin-left: 10px;
    margin-right: 2px;
    margin-top: 0;
    margin-bottom: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 1.75px;
    border-bottom-width: 1.75px;
    border-right-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    rotate: 45deg;
}

.html2uxml-dropdown-menu {
    position: absolute;
    left: 0;
    right: 0;
    background-color: rgb(255, 255, 255);
    border-width: 0.5px;
    border-color: rgb(204, 204, 204);
}

.html2uxml-dropdown-option {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin: 0;
    -unity-text-align: middle-left;
}

/* TextField placeholder + clear button (for type=search) */
.html2uxml-placeholder {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    color: rgba(0, 0, 0, 0.45);
    -unity-text-align: middle-left;
    overflow: hidden;
}

.html2uxml-clear-button {
    position: absolute;
    right: 4px;
    top: 0;
    bottom: 0;
    width: 16px;
    padding: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-center;
}

.html2uxml-clear-button:hover {
    color: rgb(13, 122, 219);
}

/* Invalid state */
.__h2u-state-invalid {
    border-color: rgb(220, 53, 69);
}

.__h2u-state-invalid > .html2uxml-toggle-box,
.__h2u-state-invalid > .html2uxml-radio-circle {
    border-color: rgb(220, 53, 69);
}
